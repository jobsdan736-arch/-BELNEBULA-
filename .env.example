# Server
PORT=4000

# Postgres — a pooled connection string from Neon, Supabase, or similar.
# Run src/db/schema.sql against this database once before starting.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Paystack — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Termii SMS — https://accounts.termii.com. Leave blank to run SMS
# delivery in mock mode (logs to console instead of sending).
TERMII_API_KEY=
TERMII_SENDER_ID=BelNebula

# SMTP for email delivery — any provider (Gmail app password, SendGrid,
# Resend SMTP, etc). Leave SMTP_HOST blank to run email in mock mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bel-Nebula <no-reply@bel-nebula.vercel.app>

# Shared secret for the /api/admin/* endpoints — pick any long random string.
ADMIN_SECRET=
